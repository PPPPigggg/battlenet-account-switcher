{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StormSwitch",
  "version": "0.1.0",
  "identifier": "dev.stormswitch.desktop",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "StormSwitch",
        "width": 1080,
        "height": 740,
        "minWidth": 860,
        "minHeight": 620,
        "resizable": true,
        "decorations": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility"
  }
}
